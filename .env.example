# filename: .env.example
# Copy to .env.local. No secrets are supplied here.
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000

# Firebase APPLICATION project, distinct from Onyx platform identity.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
# Choose service-account base64 or Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_BASE64=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/ignored/service-account.json

# Existing Onyx SDK downloaded config resolver; no NEXT_PUBLIC_ credentials.
# ONYX_CONFIG_PATH=/absolute/path/to/onyx-database.json
# ONYX_DATABASE_ID=<only if an explicit target is required by your SDK profile>

# Generated by npm run setup:secrets. Keep stable to decrypt existing outbox links.
# NOTIFICATION_ENCRYPTION_KEY=
MAIL_MODE=outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=

BILLING_MODE=disabled
# To explore without charges: APP_ENV=preview, BILLING_MODE=demo, ALLOW_DEMO_BILLING=1.
# ALLOW_DEMO_BILLING=1
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TEAM_PRICE_ID=
FREE_PROJECT_LIMIT=3
FREE_SEAT_LIMIT=3
TEAM_PROJECT_LIMIT=50
TEAM_SEAT_LIMIT=20
# Official Firebase Auth Emulator is enabled only by the test runner.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
